{
  "drone": {
    "id": "security-drone-01",
    "home_latitude": 0.0,
    "home_longitude": 0.0,
    "patrol_altitude": 30.0,
    "max_altitude": 120.0,
    "scan_radius": 100.0,
    "max_tracking_distance": 500.0,
    "tracking_timeout_seconds": 300.0,
    "scan_timeout_seconds": 120.0
  },
  "flight": {
    "adapter": "mavlink",
    "connection": "/dev/ttyAMA0",
    "baud_rate": 921600
  },
  "detection": {
    "confidence_threshold": 0.6,
    "model_backend": "yolo",
    "model_path": "yolov8n.pt"
  },
  "reporting": {
    "transport": "log",
    "http_endpoint": "http://your-platform-server:8080/api/reports",
    "api_key": "",
    "report_interval": 1.0,
    "buffer_size": 100
  },
  "triggers": {
    "http_port": 8000
  }
}
